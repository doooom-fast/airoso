 "recipes": {
  "_doc": "part + where its origin goes in the support's frame + yaw about +y (degrees, 0 = facing +z). 'drop' lists objects to leave out. Heads on an arm face +z by default; the placer turns the whole junction leg to the approach.",
  "mast_arm_heads": {
   "each head": {
    "at": "mast_arms[<arm>].head_origins_m[i]",
    "yaw_deg": 0
   }
  },
  "pedestal_head": {
   "part": "signal_head_3",
   "at": [
    0.0,
    3.5814,
    -0.1016
   ],
   "yaw_deg": 0,
   "drop": [
    "BRACKET"
   ]
  },
  "ped_head_on_pole": {
   "part": "signal_ped_head",
   "at": [
    0.0,
    2.6416,
    0.2851
   ],
   "yaw_deg": 0,
   "note": "z = the pole's radius at that height + the 0.12 m bracket; on the pedestal use pipe_radius_m"
  }
 },
