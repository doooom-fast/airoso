# sign_plate_rect_9x12 — sign plate cut to the outline, 9 x 12 in bounding rectangle
# generated by tools/make_sign_faces.py (ledger 0096); self-made, CC0-1.0
# frame: metres, +y up, origin = the plate's centre, FACE looks along +z; UV 0..1 = the bounding rectangle
vt 0.00000 0.00000
vt 1.00000 0.00000
vt 1.00000 1.00000
vt 0.00000 1.00000
o FACE
v -0.11430 0.15240 0.00200
v 0.11430 0.15240 0.00200
v 0.11430 -0.15240 0.00200
v -0.11430 -0.15240 0.00200
usemtl SIGNFACE
s off
f 4/1 3/2 2/3 1/4
o BACK
v -0.11430 0.15240 0.00000
v 0.11430 0.15240 0.00000
v 0.11430 -0.15240 0.00000
v -0.11430 -0.15240 0.00000
usemtl SIGNBACK
s off
f 5/4 6/3 7/2 8/1
