  "lm_intake": {
    "source_track": "del-mar",
    "connectors": false,
    "profile": "uncapped",
    "grid_upsample": 4,
    "_doc": "the measured profile (the elevation stage's 9 % cap undone: 33 points moved, max 1.71 m, all at the two crossings of Jimmy Durante Blvd), the 40 m 3DEP grid pre-divided to 10 m (the same samples); the line and the 13 m width are the estimate's (ledger 0064), unchanged",
    "resample_m": 1.5,
    "_resample_doc": "ledger 0083: rows every 1.5 m, not the trace's 3 m (Milford's round-5 rule), the smoothing doubled in points (the same in metres): at 3 m rows the measured banks of the boulevard crossings (25 % over 10 m) left 35 then 7 grass-on-top samples and 65 kinks/km; at 1.5 m, 2 and 6.7"
  },
