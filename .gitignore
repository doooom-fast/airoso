# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
/build/
/dist/
.pytest_cache/
.ruff_cache/

# OS
.DS_Store

# Claude Code scratch
.claude/worktrees/

# --- Generated track artifacts -------------------------------------------------
# Heavy, regenerable outputs. Keep track.config.json, source/ and route notes.
*.tif
*.npy
*.blend
*.blend1
*.fbx
*.kn5
# ...but the PUBLISHED, installable track folder IS committed (git-pullable into content/tracks).
!tracks/**/*.kn5


# vendor/: ignore everything EXCEPT the io_import_accsv add-on — that's the WORKING headless kn5
# exporter (scripts/ac/export_kn5_addon.py installs it), so it must be committed for a clean checkout
# to build. (The auto-cloned GPL kn5_native exporter, if ever present, stays ignored.)
vendor/*
!vendor/io_import_accsv
vendor/io_import_accsv/**/__pycache__/
vendor/io_import_accsv/**/*.pyc

# mined mod intermediates — license-sensitive, never commit to a public artifact
assets/props/_raw/
*.dds

# TreeFX/GrassFX: third-party .bin tree MODELS are USER-SUPPLIED + licensed — NEVER commit them.
# We only generate config that REFERENCES them by filename (extension/trees/trees.txt + [TREES]).
# The user drops licensed models into extension/trees/ locally. See docs/TREEFX-FORMAT.md.
*.bin

# --- iOS capture app (apps/prodrive-scan) --------------------------------------
# The .xcodeproj is generated from project.yml by xcodegen — commit the spec, not the project.
*.xcodeproj/
xcuserdata/
DerivedData/
*.xcuserstate

# Recorded session bundles are multi-GB and live outside git (like mined mod assets).
apps/*/captures/
*.prodrive-scan/

# --- airoso V3 additions --------------------------------------------------------
# Consumer-era engine checkouts (obsolete in the monorepo, may exist in old clones)
.engine/
# Windows noise
Thumbs.db
# Per-track build output dirs in the V3 tracks/ layout
tracks/*/build/

# V3 tracks/ layout: per-track source-of-truth data IS committed (cached elevation is
# expensive to re-derive; authored blends are the hand-edit surface, never regenerable)
!tracks/*/data/*.npy
!tracks/*/data/*.tif
!tracks/*/data/*.json
!tracks/*/loop.blend
