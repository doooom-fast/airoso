    "dips": [],
    "cambers": [],
    "_doc": "Flat lots on the river terrace: no banking, no invented camber (L10: street ports get real elevation only; this is a lot circuit, same rule).",
    "_ribbon_cols_doc": "ribbon_cols 8 dropped 2026-11-06 (ledger 0083): 0.1.0 was built on 6f7404e, whose build_mesh had no ribbon_cols (the 2-edge ribbon); under ledger 0069's rule ('wherever declared') the key would change this unbanked ribbon, and the v021 assembler never reads it (Milford's port dropped it the same way)"
  },
  "route": {
    "start_at": [
      32.974798,
      -117.257668
    ],
    "_orientation_doc": "COUNTER-CLOCKWISE (the-fastlane.co.uk; the 1987-88 broadcasts agree: pits on the right of the grid, bleachers left). S/F on the straight along the north side of the 1987 hall block, heading WEST into T1 at the hall's west end; T3 is the paddock hairpin by the oval.",
    "smooth_sigma_pts": 4.0,
    "smooth_passes": 2,
    "smooth_sigma_y_pts": 3.0,
    "divided_double": false,
    "lane_dividers": false,
